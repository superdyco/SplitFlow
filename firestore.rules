rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function taskData(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function taskAfterData(taskId) {
      return getAfter(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function isTaskMember(taskId) {
      return signedIn() && request.auth.uid in taskData(taskId).memberIds;
    }

    function isCurrentTaskMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isTaskAdmin(taskId) {
      return signedIn() && request.auth.uid in taskData(taskId).adminIds;
    }

    function createsOwnTask() {
      return signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberCount == 1
        && request.resource.data.expenseCount == 0
        && request.resource.data.status == "active";
    }

    /*
      這裡曾經有一條 `updatesSelfMembershipOnly()`，讓人把自己加進 memberIds。

      它是個洞，而且是規則層修不好的那種：規則只看得到「這次寫入的內容」，
      而邀請碼是一個**不在寫入內容裡的秘密**。那條規則寫得出「他把自己加進了
      memberIds」，寫不出「他知道邀請碼」—— 少了後者，任何登入者只要拿到
      taskId 就能加入任何任務再讀光所有支出，而 taskId 在公開報告的路徑上
      （見底下的 collection group 那條）就有。

      現在加入走 `joinTask` callable，它用 Admin SDK 寫、繞過這裡。
    */
    function updatesExpenseCountOnly() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return isCurrentTaskMember()
        && changed.hasOnly(["expenseCount", "updatedAt"]);
    }

    // admin 可以改任務，但不能奪走 owner 身分，也不能把 owner 踢出任務。
    // 最後一條擋住封存與刪除：那是 owner 專屬，走 changesStatusAsOwner。
    // 少了它，admin 從這條路一樣改得到 status，「只有 owner」就是假的。
    function updatesTaskAsAdmin(taskId) {
      return isTaskAdmin(taskId)
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.ownerId in request.resource.data.memberIds
        && resource.data.ownerId in request.resource.data.adminIds
        && request.resource.data.status == resource.data.status;
    }

    // 只有 owner 能封存、解除封存、刪除，而且這次寫入只能動 status。
    // 沒有 hasOnly 的話，owner 可以藉著改狀態的名義順便改掉別的欄位。
    function changesStatusAsOwner() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return signedIn()
        && resource.data.ownerId == request.auth.uid
        && changed.hasOnly(["status", "updatedAt"])
        && request.resource.data.status in ["active", "archived", "deleted"];
    }

    // 封存的任務唯讀。這個 get 不會多花錢 —— isTaskMember 已經讀過同一份文件，
    // Firestore 規則在同一次評估內會快取 get()。
    function taskIsActive(taskId) {
      return taskData(taskId).status == "active";
    }

    /*
      收藏起來的公開報告。**純私人資料** —— 別人不該知道你存了誰的旅程，
      所以這裡沒有任何一條規則讓別人讀得到。

      欄位形狀不寫死，只擋兩件事：掛在別人名下、以及把文件塞爆。
      裡面的內容是使用者自己抄下來的報告摘要，寫壞了只會壞掉他自己的收藏頁。
    */
    match /users/{uid}/favorites/{favoriteId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.taskId is string
        && request.resource.data.reportId is string
        && request.resource.data.keys().size() <= 16;
    }

    /*
      這台裝置的推播 token。**純私人資料**，形狀跟收藏一樣的理由也一樣 ——
      別人不該知道你用哪台裝置，更不該寫得進你的名下。

      Cloud Function 用 Admin SDK 讀，繞過規則，所以這裡可以鎖死成只有本人。

      文件 ID 就是 token 本身：重新註冊時自動覆蓋（冪等），而 FCM 回報某個
      token 失效時函式手上正好有那串 token，直接刪那份文件就好。

      欄位數上限跟收藏同一個理由：這個集合沒有人讀得到（除了本人與函式），
      不擋的話就是一塊免費的私人儲存空間。
    */
    match /users/{uid}/tokens/{token} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.platform is string
        && request.resource.data.keys().size() <= 8;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["nickname", "email", "photoURL", "provider", "updatedAt"]);
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow create: if createsOwnTask();
      allow read: if isCurrentTaskMember();
      // changesStatusAsOwner 刻意不加 taskIsActive —— 加了就解除不了封存。
      allow update: if updatesTaskAsAdmin(taskId)
        || (updatesExpenseCountOnly() && taskIsActive(taskId))
        || changesStatusAsOwner();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        // owner 不能被降級也不能被移除，admin 只能動 admin/member 兩種角色。
        //
        // 虛擬成員只能停在 member —— 升成 admin 沒有意義（他沒有帳號，adminIds 裡
        // 多一個合成 id 不會讓任何人拿到權限），但會讓成員列顯示一個永遠不會生效的
        // 「管理員」。virtual 本身也不准翻轉，否則真人與虛擬的界線就沒了。
        // 用 .get("virtual", false) 是因為既有成員文件沒有這個欄位。
        function managesMemberAsAdmin() {
          return isTaskAdmin(taskId)
            && resource.data.role != "owner"
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role in ["admin", "member"]
            && request.resource.data.get("virtual", false) == resource.data.get("virtual", false)
            && (
              resource.data.get("virtual", false) == false
              || request.resource.data.role == "member"
            );
        }

        /*
          個人設定改暱稱時，本人把自己在每個任務裡的那份副本一起換掉。

          成員文件的 nickname 是加入當下複製的一份，不是即時去讀 users/{uid}
          —— 刪掉帳號的人與虛擬成員都只有這份可讀，副本拿不掉，只能在改名時
          跟著更新。沒有這條路的話，一般成員改了暱稱，任務裡還是舊名字。

          只准動 nickname：角色、active、virtual 都不能藉這條翻轉。
          不看 active，離開過的人改名，舊帳目上的名字也該跟著對。

          `hasAll` 是要求 nickname 真的變了。少了它，什麼都沒改的寫入（例如把
          自己的 active: true 再寫一次）changedKeys 是空的，hasOnly 會放行 ——
          那等於替本人開了一條「寫任何欄位只要值沒變就通過」的路，會讓
          「還在任務裡的人不能自己動 active」那條防線看起來破了。
        */
        function renamesSelf() {
          return isSelf(uid)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["nickname"])
            && request.resource.data.diff(resource.data).changedKeys().hasAll(["nickname"]);
        }

        /*
          虛擬成員：沒有帳號的人（長輩），由 owner/admin 代為建立。

          `uid.matches` 那條是安全核心而不是格式潔癖。admin 本來就能往
          task.memberIds 塞任意字串（updatesTaskAsAdmin 沒有 hasOnly），少了它，
          這條路就是「admin 可以替任何真人偽造 member 文件」的後門。
          合成 id 固定 22 字元，Firebase uid 是 28 字元，長度就對不上。

          用 taskAfterData 而不是 taskData，理由跟下面的 create 一樣：
          member 文件與 task.memberIds 在同一個 batch 裡寫。
        */
        function createsVirtualMember() {
          return isTaskAdmin(taskId)
            && uid.matches("^v_[a-z0-9]{20}$")
            && taskAfterData(taskId).status == "active"
            && uid in taskAfterData(taskId).memberIds
            && request.resource.data.uid == uid
            && request.resource.data.virtual == true
            && request.resource.data.active == true
            && request.resource.data.role == "member";
        }

        allow get: if isSelf(uid) || isTaskMember(taskId);
        allow list: if isTaskMember(taskId);
        // 用 after 狀態而不是 taskIsActive：建立任務時，任務文件與 owner 的成員
        // 文件在同一個 batch 裡，那當下 get() 讀不到任務，會把建立任務整個擋掉。
        // 封存的任務其 after 狀態仍是 archived，所以照樣擋得住新成員加入。
        allow create: if (
            isSelf(uid)
            && taskAfterData(taskId).status == "active"
            && uid in taskAfterData(taskId).memberIds
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.active == true
            && request.resource.data.role in ["owner", "member"]
            && (
              request.resource.data.role == "member"
              || taskAfterData(taskId).ownerId == request.auth.uid
            )
          ) || createsVirtualMember();
        /*
          重新加入沒有規則 —— 那條路整條搬到 `joinTask` callable 了。

          舊版這裡有一條 `rejoinsSelf()`，讓被移除的人自己把 active 改回
          true。它本身沒問題，但它要求 uid 出現在任務的 memberIds 裡，而唯一
          能把自己放進去的路（updatesSelfMembershipOnly）已經因為是個洞而
          刪掉了 —— 留著就是一條永遠不會通過、卻看起來像自助入口的規則。
        */
        allow update: if managesMemberAsAdmin() || renamesSelf();

        /*
          真實刪除。軟刪（active: false）留給「他確實參與過，但不該再看到
          這個任務」；這條是給「這個人根本不該在這裡」——加錯人、測試資料。

          role != "owner" 不能少：軟刪走 managesMemberAsAdmin()，那裡面擋著
          owner。這條不擋的話，admin 就能把 owner 從他自己的任務裡刪掉，
          變成新路徑能做的事比舊路徑還多。

          taskIsActive 是因為封存的任務唯讀 —— 封存之後不該還能改帳。
        */
        allow delete: if isTaskAdmin(taskId)
          && taskIsActive(taskId)
          && resource.data.role != "owner";
      }

      match /expenses/{expenseId} {
        function validExpenseShape() {
          let data = request.resource.data;
          return data.title is string
            && data.title.size() > 0
            && data.title.size() <= 60
            && data.category in ["food", "transport", "stay", "ticket", "shopping", "other"]
            && data.amount is int
            && data.amount > 0
            && data.currency is string
            && data.rate is number
            && data.rate > 0
            && data.baseAmount is int
            && data.baseAmount > 0
            && data.splitMode in ["even", "custom"]
            && data.splits is map
            && data.splits.size() > 0
            && validPlace()
            && validReceipt()
            && validNote()
            && validDate()
            && validTime()
            && validWeather();
        }

        // 地點是選填。有填的話至少要有名稱，座標可以是 null（沒用 Google 搜尋時）。
        //
        // 用 .get() 而不是直接讀欄位：地點是後來才加的，之前建立的支出根本沒有這個 key，
        // 直接讀會是 evaluation error（不是 false），整條規則當場中斷。
        // 症狀是「只改收據路徑」這種局部更新在舊支出上會被擋 —— update 的
        // request.resource.data 是合併後的結果，缺的欄位不會憑空長出來。
        function validPlace() {
          let place = request.resource.data.get("place", null);
          return place == null
            || (
              place is map
              && place.name is string
              && place.name.size() > 0
              && place.name.size() <= 120
            );
        }

        // 收據是選填。有的話兩個欄位都可以是 null（待上傳時 path 是 null，
        // 傳完之後 localId 是 null），但型別不能亂。
        // 用 .get() 是因為這個功能之前建立的舊支出沒有這個欄位。
        /*
          天氣是選填的裝飾欄位。client 寫得了它 —— 那是表單預覽拿到的值，
          存檔時一起送上去。偽造天氣的風險可以忽略；反過來禁止 client 寫的話，
          編輯支出時前端送回整份文件就會把它洗掉，那更容易發生也更難察覺。

          exact 那組括號不能省：`A && B || C` 解析成 `(A && B) || C`，
          少了括號只要 exact 合法，前面所有檢查就全部被短路，驗證形同虛設。
        */
        function validWeather() {
          let weather = request.resource.data.get("weather", null);
          return weather == null
            || (
              weather is map
              && weather.code is int
              && weather.code >= 0
              && weather.code <= 99
              && weather.high is int
              && weather.high >= -90
              && weather.high <= 60
              && weather.low is int
              && weather.low >= -90
              && weather.low <= 60
              && (
                weather.get("exact", null) == null
                || (
                  weather.exact is int
                  && weather.exact >= -90
                  && weather.exact <= 60
                )
              )
            );
        }

        function validReceipt() {
          let receipt = request.resource.data.get("receipt", null);
          return receipt == null
            || (
              receipt is map
              && (receipt.path == null || receipt.path is string)
              && (receipt.localId == null || receipt.localId is string)
            );
        }

        // 備註是選填，最多 500 字。
        // 用 .get() 是因為這個功能之前建立的舊支出沒有這個欄位。
        function validNote() {
          let note = request.resource.data.get("note", "");
          return note is string && note.size() <= 500;
        }

        // 時間是選填的 "HH:MM"（24 小時制），空字串代表沒記。
        // 比照 note 用 .get()：這個功能之前建立的支出沒有這個欄位。
        /*
          日期是後來才加的欄位，所以走 `.get` 而不是直接讀 —— 沒有這個 key 的
          舊支出直接讀會是 evaluation error（不是 false），整條規則當場中斷，
          症狀跟 validPlace 註解裡寫的一樣：只改收據路徑那種局部更新會被擋掉。

          所以空字串要放行：舊支出的 `.get` 拿到的就是預設值。表單一律會送
          `date.value || todayInput()`，新支出不會走到那一支。

          用 [0-9] 而不是 \d：規則檔裡的字串會再被跳脫一層，[0-9] 沒有這個問題。
        */
        function validDate() {
          let date = request.resource.data.get("date", "");
          return date is string
            && (date == "" || date.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}"));
        }

        function validTime() {
          let time = request.resource.data.get("time", "");
          return time is string
            && (time == "" || time.matches("([01][0-9]|2[0-3]):[0-5][0-9]"));
        }

        function validNewParticipants() {
          let members = taskData(taskId).memberIds;
          return request.resource.data.paidBy in members
            && request.resource.data.splits.keys().hasOnly(members);
        }

        // 已被移除的成員可以留在原本就有他的支出裡，但不能把新的陌生 uid 加進來。
        // splitMemberIds 是加入自訂分攤之前的舊欄位，舊支出被編輯時要一併認得。
        function validEditedParticipants() {
          let allowed = taskData(taskId).memberIds
            .concat(resource.data.get("splits", {}).keys())
            .concat(resource.data.get("splitMemberIds", []))
            .concat([resource.data.paidBy]);
          return request.resource.data.paidBy in allowed
            && request.resource.data.splits.keys().hasOnly(allowed);
        }

        // 一般成員只能動自己建立或自己先付的支出，owner/admin 可以動全部。
        function canManageExpense() {
          return isTaskAdmin(taskId)
            || resource.data.createdBy == request.auth.uid
            || resource.data.paidBy == request.auth.uid;
        }

        // 讀取不受封存影響 —— 封存的重點就是留著查。寫入才擋。
        allow get, list: if isTaskMember(taskId);
        allow create: if isTaskMember(taskId)
          && taskIsActive(taskId)
          && request.resource.data.createdBy == request.auth.uid
          && validExpenseShape()
          && validNewParticipants();
        allow update: if isTaskMember(taskId)
          && taskIsActive(taskId)
          && canManageExpense()
          && request.resource.data.createdBy == resource.data.createdBy
          && validExpenseShape()
          && validEditedParticipants();
        allow delete: if isTaskMember(taskId) && taskIsActive(taskId) && canManageExpense();
      }

      match /payments/{paymentId} {
        function validPayment() {
          let data = request.resource.data;
          return data.from is string
            && data.to is string
            && data.from != data.to
            && data.amount is int
            && data.amount > 0
            && data.currency is string
            && data.status in ["pending", "confirmed"];
        }

        function isParty() {
          return request.auth.uid == request.resource.data.from
            || request.auth.uid == request.resource.data.to;
        }

        allow get, list: if isTaskMember(taskId);

        // 只能記錄跟自己有關的付款；只有收款人（或 admin）能一開始就記成已確認，
        // 因為只有收款的人能證明錢真的到了。
        allow create: if isTaskMember(taskId)
          && taskIsActive(taskId)
          && request.resource.data.createdBy == request.auth.uid
          && validPayment()
          && (isParty() || isTaskAdmin(taskId))
          && (
            request.resource.data.status == "pending"
            || request.auth.uid == request.resource.data.to
            || isTaskAdmin(taskId)
          );

        // 確認收到：只有收款人或 admin，而且只能 pending 變 confirmed。
        allow update: if isTaskMember(taskId)
          && taskIsActive(taskId)
          && (request.auth.uid == resource.data.to || isTaskAdmin(taskId))
          && resource.data.status == "pending"
          && request.resource.data.status == "confirmed"
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "confirmedAt", "updatedAt"]);

        allow delete: if isTaskMember(taskId)
          && taskIsActive(taskId)
          && (
            request.auth.uid == resource.data.from
            || request.auth.uid == resource.data.to
            || isTaskAdmin(taskId)
          );
      }

      match /settlements/{settlementId} {
        function validSnapshot() {
          let data = request.resource.data;
          return data.currency is string
            && data.total is int
            && data.total >= 0
            && data.paidTotal is int
            && data.paidTotal >= 0
            && data.expenseCount is int
            && data.expenseCount >= 0
            && data.balances is list
            && data.transfers is list
            && data.memberNames is map
            && data.note is string
            && data.note.size() <= 200;
        }

        allow get, list: if isTaskMember(taskId);

        // 結算快照是歷史紀錄，存下來就不能改，只能由 owner/admin 整份刪掉。
        allow create: if isTaskAdmin(taskId)
          && taskIsActive(taskId)
          && request.resource.data.createdBy == request.auth.uid
          && validSnapshot();
        allow update: if false;
        allow delete: if isTaskAdmin(taskId) && taskIsActive(taskId);
      }

      // 公開的旅費報告。這是整份規則裡唯一開放未登入讀取的地方。
      match /reports/{reportId} {
        // 撤銷就是 active 改成 false，讀取直接失敗，頁面顯示找不到。
        // 跟 invites 是同一個模式。成員仍讀得到已關閉的，才能重新開啟。
        allow get: if resource.data.active == true || isTaskMember(taskId);
        // 成員才列得出來 —— owner 的介面靠這個找到既有報告來沿用 id。
        allow list: if isTaskMember(taskId);
        // 只有 owner 能產生與撤銷：公開別人的消費資料只有他能決定。
        // 不加 taskIsActive —— 報告本來就只在封存後產生，而封存的任務
        // 仍要能重新產生與撤銷報告。
        allow create, update: if taskData(taskId).ownerId == request.auth.uid;
        allow delete: if false;
      }
    }

    /*
      耗時分段的樣本。每次進「我的任務」寫一筆，用來回答「手機上到底卡在哪一段」。

      只能建立，不能讀、不能改、不能刪：

        - 不能讀，是因為這裡面有 uid 與 userAgent，而且沒有任何一個使用者需要
          看別人的效能資料。要查的人是開發者，Console 與 Admin SDK 本來就繞過規則。
        - 不能改也不能刪，是因為量測資料被事後動過就沒有價值了。

      驗證只擋「掛在別人名下」與「塞爆一筆文件」這兩件事。欄位形狀刻意不寫死：
      之後多量一段就要改一次規則、還要等部署，那筆帳划不來，而這個集合沒有人讀。
    */
    match /perf/{sampleId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.page is string
        && request.resource.data.total is number
        && request.resource.data.phases is map
        && request.resource.data.keys().size() <= 24;
      allow update, delete: if false;
    }

    /*
      探索頁的清單查詢。

      這條非得用遞迴萬用字元不可：底下那條 /tasks/{taskId}/reports/{reportId}
      只管「某一個任務裡的報告」，collection group 查詢（跨所有任務找 reports）
      不會命中它。

      條件跟查詢的 where 完全對齊，這是 Firestore 的「安全查詢」寫法 ——
      規則逐筆檢查回傳的文件，只要有一筆不符整個查詢就失敗，所以查詢
      本身必須把範圍縮到規則允許的那些。

      listed 用 .get() 是因為這個功能之前產生的報告根本沒有這個 key，
      直接讀會是 evaluation error（不是 false），整條規則當場中斷。

      注意這條只給 list。單一份報告的讀取仍然走底下那條 —— 那裡才是
      「拿到連結就看得到」的判斷，跟有沒有公開無關。
    */
    match /{path=**}/reports/{reportId} {
      allow list: if signedIn()
        && resource.data.get("listed", false) == true
        && resource.data.active == true;
    }

    /*
      邀請連結。**get 而不是 read** —— `read` 同時給 get 與 list，而
      「拿到碼才看得到」的語義只需要 get。舊版寫成 read，於是
      `where("active","==",true)` 這種查詢就能把整個集合撈出來：一份
      所有旅程的 taskId、名稱與發起人 uid 清單，連登入都不必。

      建立的人必須是那個任務的 owner。少了這條，任何登入者都能偽造一份
      指向別人 taskId 的邀請文件，再拿它去呼叫 joinTask —— 把整個伺服器端
      驗證繞過去。（callable 那邊也拿 task.inviteCode 對過一次；兩道都留著，
      因為這兩個檔案會分開被修改。）

      用 taskAfterData 而不是 taskData：邀請文件跟任務在同一個 batch 裡
      建立，那當下 get() 還讀不到任務。
    */
    match /invites/{inviteCode} {
      allow get: if resource.data.active == true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.taskId is string
        && taskAfterData(request.resource.data.taskId).ownerId == request.auth.uid;
      // 邀請文件建立後就不會再變動，沒有停用或重新產生連結的功能。
      allow update, delete: if false;
    }
  }
}
