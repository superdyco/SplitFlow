{
  "name": "splitflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-chunks.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-splitflow \"node tests/firestore.rules.test.mjs && node tests/storage.rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes,storage",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "chart.js": "^4.5.1",
    "firebase": "^12.18.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/google.maps": "^3.65.4",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.25.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.10"
  }
}
